# XenMange Configuration
NODE_ENV=development
PORT=3000

# XenServer Connection (stored in SQLite after first login)
# XENSERVER_HOST=
# XENSERVER_USER=root
# XENSERVER_PASSWORD=

# Session
SESSION_SECRET=change-this-to-a-random-string
SESSION_MAX_AGE=86400000

# Database
DB_PATH=./data/xenmange.db
