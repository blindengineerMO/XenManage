# XenMange Configuration
NODE_ENV=development
PORT=3000

# XenServer Connection (stored in SQLite after first login)
# XENSERVER_HOST=
# XENSERVER_USER=root
# XENSERVER_PASSWORD=

# Session
SESSION_SECRET=change-this-to-a-random-string
SESSION_MAX_AGE=86400000
# General API request budget, distinct from the tighter login throttle.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
# JSON log verbosity: debug, info, warn, or error.
LOG_LEVEL=info
# Optional Sentry DSN for server exception tracking.
SENTRY_DSN=
# Admin-only SQLite control-plane snapshots are written here.
CONTROL_PLANE_BACKUP_PATH=./data/backups

# XenMange Control-Plane Bootstrap User
XENMANGE_BOOTSTRAP_USERNAME=admin
XENMANGE_BOOTSTRAP_PASSWORD=change-this-bootstrap-password
XENMANGE_BOOTSTRAP_DISPLAY_NAME=Platform Administrator

# Database
DB_PATH=./data/xenmange.db
SECURITY_DB_PATH=./data/security.db
VAULT_DB_PATH=./data/vault.db
PERF_DB_PATH=./data/perf.db

# Credential Vault
# Use a 32-byte base64 key in production. In development/test, XenMange derives a local fallback key from SESSION_SECRET.
# VAULT_ENCRYPTION_KEY=
# VAULT_ENCRYPTION_KEY_PREVIOUS=

# Control-Plane Backup Recovery Key
# Snapshot database files under CONTROL_PLANE_BACKUP_PATH are AES-256-GCM encrypted at rest with
# this key, kept deliberately separate from VAULT_ENCRYPTION_KEY so a snapshot stays restorable
# even in a disaster where the primary deployment (and its vault key) is gone. Use a 32-byte
# base64 key in production; development/test falls back to a local key derived from SESSION_SECRET.
# CONTROL_PLANE_BACKUP_RECOVERY_KEY=
# CONTROL_PLANE_BACKUP_RECOVERY_KEY_PREVIOUS=
# Comma-separated exact hosts or explicit wildcards such as *.approvals.example.com.
# CATALOG_APPROVAL_HOOK_ALLOWLIST=approvals.example.com
# CATALOG_APPROVAL_HOOK_TIMEOUT_MS=5000
# CATALOG_APPROVAL_HOOK_MAX_ATTEMPTS=3

# User Profile (avatars)
# PROFILE_AVATAR_ROOT=./data/avatars
# PROFILE_AVATAR_MAX_BYTES=2097152

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# OIDC SSO login (optional; adds a "Sign in with SSO" button to the login screen).
# Required together when OIDC_ENABLED=true: issuer, client ID/secret, and redirect URI.
# OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# OIDC_SCOPE=openid profile email
# OIDC_BUTTON_LABEL=Sign in with SSO
# Role granted to a newly auto-provisioned OIDC user on first login.
# OIDC_DEFAULT_ROLE=operator
# Comma-separated email domains allowed to sign in via OIDC; empty allows any domain.
# OIDC_ALLOWED_EMAIL_DOMAINS=

# LDAP / Active Directory login (optional; tried on POST /api/auth/login before local
# password auth, falling through to local on any miss — a broken/unreachable directory
# never locks out local-only accounts such as the bootstrap admin).
# Required together when LDAP_ENABLED=true: URL, bind DN/password, and search base.
# LDAP_ENABLED=false
# LDAP_URL=ldaps://ldap.example.com
# Service account used to search for the login candidate's DN.
# LDAP_BIND_DN=cn=service-account,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# {{username}} is substituted with the submitted login name. Active Directory example:
# "(sAMAccountName={{username}})".
# LDAP_SEARCH_FILTER=(uid={{username}})
# LDAP_USERNAME_ATTRIBUTE=uid
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_DISPLAY_NAME_ATTRIBUTE=cn
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# Role granted to a newly auto-provisioned LDAP user on first login.
# LDAP_DEFAULT_ROLE=operator
# Comma-separated email domains allowed to sign in via LDAP; empty allows any domain.
# LDAP_ALLOWED_EMAIL_DOMAINS=

# WebAuthn/FIDO2 security keys (optional second factor alongside/instead of TOTP).
# rpID and origin are derived per-request from the inbound hostname unless set here;
# only needed if XenMange sits behind a reverse proxy that rewrites the Host header.
# WEBAUTHN_RP_NAME=XenMange
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=

# SAML SSO login (optional; adds a "Sign in with SAML" button to the login screen).
# Required together when SAML_ENABLED=true: entry point, cert, and callback URL.
# SAML_ENABLED=false
# SAML_ENTRY_POINT=https://idp.example.com/sso
# SAML_ISSUER=xenmange
# SAML_CERT=
# SAML_CALLBACK_URL=http://localhost:3000/api/auth/saml/callback
# SAML_BUTTON_LABEL=Sign in with SAML
# Role granted to a newly auto-provisioned SAML user on first login.
# SAML_DEFAULT_ROLE=operator
# Comma-separated email domains allowed to sign in via SAML; empty allows any domain.
# SAML_ALLOWED_EMAIL_DOMAINS=
